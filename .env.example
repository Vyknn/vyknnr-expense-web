# PostgreSQL connection. DB_DRIVER is currently informational (only "postgres" is supported).
DB_DRIVER=postgres
DB_PRIMARY_DSN=

# GCS bucket that stores compressed receipt images: "<bucket>" or "<bucket>/<prefix>" (no
# gs:// scheme) — the optional prefix lets several apps share one bucket under separate folders.
GOOGLE_BUCKET_PATH=

# Path to a GCS service-account key JSON file (e.g. certs/google.json — gitignored, never
# commit it). Leave unset to fall back to Application Default Credentials instead (e.g.
# `gcloud auth application-default login` locally, or the attached service account on Cloud Run).
GOOGLE_CERT_PATH=

# Required only once, when the database has no users. Store real values in Secret Manager.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
